rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.uid == userId ||
         request.auth.uid == resource.data.studyAccountUid ||
         request.auth.uid == resource.data.messengerAccountUid);
    }

    // Messages - only authenticated users can read/write
    match /messages/{chatId}/msgs/{msgId} {
      allow read, write: if request.auth != null;
    }

    // Chats - only authenticated users can access
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    // Study progress - only owner
    match /studyProgress/{userId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId;
    }

    // Stories - authenticated users
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    // Notifications - only recipient can read
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.toUserId == request.auth.uid;
      allow write: if request.auth != null;
    }

    // Calls - authenticated users
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
    match /calls/{callId}/{subCollection}/{docId} {
      allow read, write: if request.auth != null;
    }

    // System docs
    match /system/{docId} {
      allow read, write: if request.auth != null;
    }

    // Groups
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }
  }
}
