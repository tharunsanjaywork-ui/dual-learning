VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Primary Cloudinary (client uploads via unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=dualzone_preset

# Secondary Cloudinary (backup failover)
VITE_CLOUDINARY2_CLOUD_NAME=your_backup_cloud_name
VITE_CLOUDINARY2_UPLOAD_PRESET=dualzone_backup_preset

# WebRTC TURN credentials (optional fallback for strict symmetric NATs)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

VITE_GIPHY_API_KEY=your_giphy_api_key
